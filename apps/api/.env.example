AIGYM_ENV=development
AIGYM_DATABASE_URL=postgresql+psycopg://aigym_app:aigym_app@localhost:5432/aigym
AIGYM_DATABASE_URL_MIGRATIONS=postgresql+psycopg://postgres:postgres@localhost:5432/aigym
AIGYM_JWT_SECRET=dev-secret-change-me-32-bytes-minimum
AIGYM_CORS_ORIGINS=["http://localhost:5173"]
# Phase 5. Unset is a supported state: every AI route answers 503 rather
# than 500 until a real key is present (decision 29).
AIGYM_ANTHROPIC_API_KEY=
